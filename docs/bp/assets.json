  {
    "id": "BP-ASSETS-01",
    "area": "assets",
    "title": "Register, correct and retire an asset card",
    "description": "The administrator creates an asset card (inventory number, kind fixed / low value / intangible, name, optional ДА-2 attributes), changes it, retires it and prints the official card form ДА-2. A card that has a posted document is locked: its inventory number and kind cannot change.",
    "actors": [
      {
        "role": "TENANT_ADMIN",
        "permission": "AssetsCardWrite"
      },
      {
        "role": "STOREKEEPER",
        "permission": "AssetsRead (grantable)"
      }
    ],
    "preconditions": [
      "module assets installed",
      "the currency is the tenant currency"
    ],
    "inputs": [
      "inventory_number",
      "kind",
      "name"
    ],
    "outputs": [
      "card_id"
    ],
    "refusals": [
      "a role without AssetsCardWrite (never grantable) is 403",
      "a changed inventory_number or kind on a locked card is refused",
      "a currency that is not the tenant currency is refused"
    ],
    "status": "implemented",
    "tasks": [
      {
        "actor": "TENANT_ADMIN",
        "forms": [
          "cards -> AssetCardsPage",
          "admin/assets"
        ],
        "functions": [],
        "route": [
          "POST /api/v1/modules/assets/cards",
          "PATCH /api/v1/modules/assets/cards/:id"
        ],
        "code_refs": [
          "web/src/modules/assets/assetsRoutes.tsx:23",
          "web/src/modules/assets/assetsRoutes.tsx:21",
          "lib/letflow/modules/assets/router.ex:179",
          "lib/letflow/modules/assets/router.ex:185"
        ],
        "result": "the card is created or changed (a managed type: generic record routes answer 403 entity_type_managed)"
      },
      {
        "actor": "TENANT_ADMIN",
        "forms": [
          "cards -> AssetCardsPage"
        ],
        "functions": [
          "Letflow.Modules.Assets.Documents.Checks.held?"
        ],
        "route": "GET /api/v1/modules/assets/cards/:id/lock",
        "code_refs": [
          "web/src/modules/assets/assetsRoutes.tsx:23",
          "lib/letflow/modules/assets/documents/checks.ex:298",
          "lib/letflow/modules/assets/router.ex:200"
        ],
        "result": "whether the card has a posted document (held)"
      },
      {
        "actor": "TENANT_ADMIN",
        "forms": [
          "cards -> AssetCardsPage"
        ],
        "functions": [],
        "route": "POST /api/v1/modules/assets/cards/:id/retire",
        "code_refs": [
          "web/src/modules/assets/assetsRoutes.tsx:23",
          "lib/letflow/modules/assets/router.ex:191"
        ],
