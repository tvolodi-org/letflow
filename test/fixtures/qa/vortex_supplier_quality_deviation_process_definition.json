{
  "name": "Supplier Quality Deviation",
  "version": "1.8",
  "description": "Raised when incoming goods fail inspection. Quality Manager classifies severity. For CRITICAL a sub-process is spawned. Exercises: sub-process spawn, severity-driven branching, compensation. If the Quality Manager does not classify the severity in time, the default-to-critical step sets severity to critical explicitly: an unclassified deviation is handled as critical (8D corrective action) until a human classifies it. Escalation follows D-ESC: timer -> higher role -> fail closed (v1.6, ISS-1002 / Q-984; BA ruling GH #2281). severity-classification (role-quality-manager, PT4H) carries the escalation_timer_duration + escalation_role pair; when the timer fires the engine cancels the task and follows the node's single unconditioned (timeout) edge, so the normal-completion edge e2 carries the constant condition 'true'. Chain: severity-classification -> escalate-severity-classification-to-ceo (role-ceo, PT4H, takes the same classification) -> stalled: default-to-critical (severity critical, 8D corrective action), never a release of the quarantine. The 8D child (8D Corrective Action v1.1) carries a documented waiver. Deviations (documented): the stalled escalation level repeats its own role as escalation_role (co-required CHK-21 attribute only) because there is no third level; the duration is the BA E7 operational default. Required decision outputs (v1.7, REQ-462 / Q-1025, REQ-459 design): severity-classification and its D-ESC escalation task escalate-severity-classification-to-ceo declare required_outputs [severity] (an escalation task inherits nothing), already typed by variable_schemas, so completing either without a severity is refused with a retryable 422 (output_refused) instead of falling through to default-to-critical. false_positive is not adopted in this version.",
  "graph": {
    "nodes": [
      {
        "id": "start",
        "node_type": "START"
      },
      {
        "id": "quarantine-batch",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/mes/batches/{{variables.batch_ref}}/quarantine",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "severity-classification",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-quality-manager",
          "escalation_timer_duration": "PT4H",
          "escalation_role": "role-ceo",
          "required_outputs": ["severity"],
          "form_schema": {
            "type": "object",
            "properties": {
              "severity": {"type": "string", "title": "Severity", "description": "Severity of the supplier quality deviation. The routing reads this field: critical starts the 8D corrective action, major issues a supplier warning, minor a supplier notification.", "enum": ["critical", "major", "minor"]}
            },
            "required": ["severity"]
          }
        }
      },
      {
        "id": "escalate-severity-classification-to-ceo",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-ceo",
          "description": "top of chain: escalation_role is nominal; stalled = fail closed",
          "escalation_timer_duration": "PT4H",
          "escalation_role": "role-ceo",
          "required_outputs": ["severity"],
          "form_schema": {
            "type": "object",
            "properties": {
              "severity": {"type": "string", "title": "Severity", "description": "Severity of the supplier quality deviation. The routing reads this field: critical starts the 8D corrective action, major issues a supplier warning, minor a supplier notification.", "enum": ["critical", "major", "minor"]}
            },
            "required": ["severity"]
          }
        }
      },
      {
        "id": "false-positive-check",
        "node_type": "EXCLUSIVE_GATEWAY"
      },
      {
        "id": "release-quarantine",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/mes/batches/{{variables.batch_ref}}/release",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "severity-routing",
        "node_type": "EXCLUSIVE_GATEWAY"
      },
      {
        "id": "corrective-action-subprocess",
        "node_type": "SUB_PROCESS",
        "attributes": {
          "definition_name": "8D Corrective Action"
        }
      },
      {
        "id": "default-to-critical",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/response-headers?severity=critical",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "supplier-warning",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/webhooks/supplier-warning",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "supplier-notification",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/webhooks/supplier-notify",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "close-deviation",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/quality/deviations/{{variables.deviation_id}}/close",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "end-closed",
        "node_type": "END"
      },
      {
        "id": "end-false-positive",
        "node_type": "END"
      }
    ],
    "edges": [
      { "id": "e0",                             "source": "start",                        "target": "quarantine-batch" },
      { "id": "e1",                             "source": "quarantine-batch",             "target": "severity-classification" },
      { "id": "e2",                             "source": "severity-classification",      "target": "false-positive-check", "condition": "true" },
      { "id": "timeout-severity-classification", "source": "severity-classification",     "target": "escalate-severity-classification-to-ceo" },
      { "id": "e2-escalated",                   "source": "escalate-severity-classification-to-ceo", "target": "false-positive-check", "condition": "true" },
      { "id": "timeout-escalate-severity-classification-to-ceo", "source": "escalate-severity-classification-to-ceo", "target": "default-to-critical" },
      { "id": "e3",                             "source": "false-positive-check",         "target": "release-quarantine",           "condition": "variables.false_positive == true" },
      { "id": "e4",                             "source": "false-positive-check",         "target": "severity-routing",             "condition": "variables.false_positive == false" },
      { "id": "false-positive-check-default", "source": "false-positive-check", "target": "severity-routing", "is_default": true },
      { "id": "e5",                             "source": "default-to-critical",             "target": "severity-routing" },
      { "id": "e6",                             "source": "severity-routing",             "target": "corrective-action-subprocess", "condition": "variables.severity == 'critical'" },
      { "id": "e7",                             "source": "severity-routing",             "target": "supplier-warning",             "condition": "variables.severity == 'major'" },
      { "id": "e8",                             "source": "severity-routing",             "target": "supplier-notification",        "condition": "variables.severity == 'minor'" },
      { "id": "severity-routing-default", "source": "severity-routing", "target": "corrective-action-subprocess", "is_default": true },
      { "id": "e9",                             "source": "corrective-action-subprocess", "target": "close-deviation" },
      { "id": "e10",                            "source": "supplier-warning",             "target": "close-deviation" },
      { "id": "e11",                            "source": "supplier-notification",        "target": "close-deviation" },
      { "id": "e12",                            "source": "release-quarantine",           "target": "end-false-positive" },
      { "id": "e13",                            "source": "close-deviation",              "target": "end-closed" }
    ]
  },
  "variable_schemas": [
    {"variable_key": "false_positive", "json_schema": {"type": "boolean"}},
    {"variable_key": "severity", "json_schema": {"type": "string", "enum": ["critical", "major", "minor"]}}
  ]
}
