{
  "id": "BP-01",
  "title": "Receive goods",
  "description": "A storekeeper creates a receipt of `quantity` units (default 5), issues it, an administrator claims and completes the Post task, the balance of the item at the place grows by the quantity. The cleanup reverses the document (reason fields required by the API) and completes the Reverse task, so the balance returns to its start.",
  "tenant": "${tenant}",
  "inputs": ["item", "place", "org_unit", "responsible"],
  "defaults": {"quantity": "5"},
  "steps": [
    {
      "id": "s0",
      "actor": "storekeeper",
      "do": {"api": "GET", "path": "/api/v1/modules/stock/balances?sku=${item}&location=${place}&org_unit=${org_unit}&responsible=${responsible}"},
      "expect": {"status": 200},
      "save": {
        "balance_before": {"pick": "$.rows[0].quantity", "default": "0"},
        "uom": {"pick": "$.rows[0].unit_ref", "if_unset": true}
      }
    },
    {
      "id": "s1",
      "actor": "storekeeper",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/stock/documents",
        "body": {
          "kind": "receipt",
          "org_unit_id": "${org_unit}",
          "location_id": "${place}",
          "responsible_id": "${responsible}",
          "event_time": "${now_utc}",
          "note": "UAT ${run_id}",
          "lines": [{"catalog_item_id": "${item}", "catalog_uom_id": "${uom}", "quantity": "${quantity}"}]
        }
      },
      "expect": {"status": 201, "json": {"state": "draft"}},
      "save": {"doc_id": "$.id"}
    },
    {
      "id": "s2",
      "actor": "storekeeper",
      "do": {"api": "POST", "path": "/api/v1/modules/stock/documents/${doc_id}/issue"},
      "expect": {"status": 200, "json": {"state": "issued"}}
    },
    {
      "id": "s3",
      "actor": "admin",
      "do": {
        "wait_task": {"for_document": "${doc_id}", "step": "post", "within_s": 30},
        "claim": true,
        "complete": {"body": {}}
      },
      "expect": {"status": 200},
      "save": {"posted_doc_id": "${doc_id}"}
    },
    {
      "id": "s4",
      "actor": "admin",
      "do": {"api": "GET", "path": "/api/v1/modules/stock/balances?sku=${item}&location=${place}&org_unit=${org_unit}&responsible=${responsible}"},
      "expect": {"status": 200, "json": {"$.rows[0].quantity": {"equals": "${balance_before + quantity}"}}},
      "save": {"balance_after": "$.rows[0].quantity"}
    },
    {
      "id": "s5",
      "actor": "admin",
      "do": {"api": "GET", "path": "/api/v1/modules/stock/documents/${doc_id}"},
      "expect": {"status": 200, "json": {"state": "posted", "entry_id": {"exists": true}}},
      "save": {"entry_id": "$.entry_id"}
    }
  ],
  "outputs": {
    "receipt_doc_id": "${doc_id}",
    "receipt_entry_id": "${entry_id}",
    "balance_after": "${balance_after}"
  },
  "cleanup": [
    {
      "id": "c1",
      "actor": "admin",
      "requires": ["posted_doc_id"],
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/stock/documents/${posted_doc_id}/reverse",
        "body": {"reason_code": "other", "reason_text": "UAT ${run_id} cleanup of BP-01"}
      },
      "expect": {"status": 200}
    },
    {
      "id": "c2",
      "actor": "admin",
      "requires": ["posted_doc_id"],
      "do": {
        "wait_task": {"for_document": "${posted_doc_id}", "step": "reverse", "within_s": 30},
        "claim": true,
        "complete": {"body": {}}
      },
      "expect": {"status": 200}
    },
    {
      "id": "c3",
      "actor": "admin",
      "requires": ["posted_doc_id"],
      "do": {"api": "GET", "path": "/api/v1/modules/stock/balances?sku=${item}&location=${place}&org_unit=${org_unit}&responsible=${responsible}"},
      "expect": {"status": 200, "json": {"$.rows[0].quantity": {"equals": "${balance_before}", "default": "0"}}},
      "save": {"balance_end": {"pick": "$.rows[0].quantity", "default": "0"}}
    }
  ]
}
