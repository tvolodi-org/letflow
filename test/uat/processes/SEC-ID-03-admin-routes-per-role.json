{
  "id": "SEC-ID-03",
  "bp_entry": "BP-TENANT-ADMIN-44",
  "title": "Administration routes per role: the tenant administrator may read them, the storekeeper is refused every read and every change with one identical answer",
  "description": "The tenant administrator reads the approval rules, the ledger settings, the audit log, the API tokens, the users, the groups and the shared access status: each answers 200. The storekeeper sends the same reads and the changes of the same routes (approval rule, ledger setting, API token, user): every one is refused with 403 and the same body (Forbidden, insufficient permissions). The permission is checked before the request body is read, so the change requests carry an empty body on purpose: if a refusal were missing, the empty body is invalid and changes nothing. At the end the administrator reads the approval rules and the ledger setting again: unchanged (compared with the values read at the start). Not in this file (the static check cannot match a route mounted under a two-part prefix): role grants, scoped role grants, company settings, scope enforcement mode; see the map entry. Read-only for the administrator; no cleanup.",
  "tenant": "${tenant}",
  "inputs": [],
  "dry_run": {
    "tenant": "qoimeks-qa2",
    "actors": {
      "admin": "qoimeks-qa2-admin",
      "storekeeper": "qoimeks-qa2-storekeeper"
    },
    "inputs": {}
  },
  "steps": [
    {
      "id": "s1",
      "actor": "admin",
      "do": {
        "api": "GET",
        "path": "/api/v1/approval-rules"
      },
      "expect": {
        "status": 200,
        "json": {
          "$.items[0].definition_name": {
            "exists": true
          }
        }
      },
      "save": {
        "rule_definition": "$.items[0].definition_name",
        "rule_node": "$.items[0].node_id"
      }
    },
    {
      "id": "s2",
