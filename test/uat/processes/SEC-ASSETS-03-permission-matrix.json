{
  "id": "SEC-ASSETS-03",
  "bp_entry": "BP-ASSETS-15",
  "title": "Permission matrix of the assets area: storekeeper (tenant grant read and post) and administrator",
  "description": "SECURITY, read-and-refuse only, on qoimeks-qa. This tenant has the storekeeper grant of the assets module switched on (read and post only; reverse, reconcile, card changes and counts are never grantable). The storekeeper reads asset balances, movements and documents (200) and is refused 403 on the reconciliation, on making or retiring a card, on reversing a document and on making a count order: refused at the permission check, before anything is read or written. The administrator reads the same and the reconciliation (200); for an unknown document id the reversal answers 404 (the permission is held, the document does not exist), where the storekeeper got 403. Nothing is created, so there is nothing to clean up. Precondition: the storekeeper grant is on (step s1 fails with 403 if it is off on the tenant).",
  "tenant": "${tenant}",
  "inputs": [],
  "dry_run": {
    "blocked_by": "assets-module-on-active-tenant",
    "tenant": "qoimeks-qa2",
    "actors": {
      "admin": "qoimeks-qa2-admin",
      "storekeeper": "qoimeks-qa2-storekeeper"
    },
    "inputs": {}
  },
  "steps": [
    {
      "id": "s1",
      "actor": "storekeeper",
      "do": {
        "assert_only": {
          "path": "/api/v1/modules/assets/balances"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "id": "s2",
      "actor": "storekeeper",
      "do": {
        "assert_only": {
          "path": "/api/v1/modules/assets/movements"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "id": "s3",
      "actor": "storekeeper",
      "do": {
        "assert_only": {
          "path": "/api/v1/modules/assets/documents"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "id": "s4",
      "actor": "storekeeper",
      "do": {
        "assert_only": {
          "path": "/api/v1/modules/assets/reconcile"
        }
      },
      "expect_refused": {
        "status": 403
      }
    },
    {
      "id": "s5",
      "actor": "storekeeper",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/assets/cards",
        "body": {}
      },
      "expect_refused": {
        "status": 403
      }
    },
    {
      "id": "s6",
      "actor": "storekeeper",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/assets/documents/00000000-0000-4000-8000-0000000000c5/reverse",
        "body": {
          "reason_code": "other",
          "reason_text": "UAT ${run_id} probe"
        }
      },
      "expect_refused": {
        "status": 403
      }
    },
    {
      "id": "s7",
      "actor": "storekeeper",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/assets/counts",
        "body": {}
      },
      "expect_refused": {
        "status": 403
      }
    },
    {
      "id": "s8",
      "actor": "storekeeper",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/assets/cards/00000000-0000-4000-8000-0000000000c6/retire",
        "body": {}
      },
      "expect_refused": {
        "status": 403
      }
    },
    {
      "id": "s9",
      "actor": "admin",
      "do": {
        "assert_only": {
          "path": "/api/v1/modules/assets/balances"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "id": "s10",
      "actor": "admin",
      "do": {
        "assert_only": {
          "path": "/api/v1/modules/assets/movements"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "id": "s11",
      "actor": "admin",
      "do": {
        "assert_only": {
          "path": "/api/v1/modules/assets/documents"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "id": "s12",
      "actor": "admin",
      "do": {
        "assert_only": {
          "path": "/api/v1/modules/assets/reconcile"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "id": "s13",
      "actor": "admin",
      "do": {
