{
  "id": "SEC-MASTER-03",
  "bp_entry": "BP-MASTER-14",
  "title": "A call with no credential never reaches a master data route (401 on all four modules)",
  "description": "SECURITY, read-and-refuse only, on qoimeks-qa2. A caller that sends no credential calls one write route of each module (org legal entities and units, locations, catalog lots, codes receive) and the two reads of the codes module (scan lookup, label print): every call is 401 and nothing is written. The last step is the control: the administrator's own call on an unknown id passes the sign-in and reaches the route (404). A wrong, expired or other-tenant token needs a per-step bearer the runner does not have: planned, covered by the Elixir tests of the auth pipeline. Nothing is created, so there is nothing to clean up.",
  "dry_run": {
    "tenant": "qoimeks-qa2",
    "actors": {
      "admin": "qoimeks-qa2-admin",
      "storekeeper": "qoimeks-qa2-storekeeper"
    },
    "inputs": {}
  },
  "steps": [
    {
      "id": "s1",
      "actor": "anonymous",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/org/legal-entities",
        "body": {
          "code": "X",
          "name": "X",
          "bin": "123456789012",
          "idempotency_key": "uat-${run_id}-03a"
        }
      },
      "expect_refused": {
        "status": 401
      }
    },
    {
      "id": "s2",
      "actor": "anonymous",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/org/units",
        "body": {
          "code": "X",
          "name": "X",
          "idempotency_key": "uat-${run_id}-03b"
        }
      },
      "expect_refused": {
        "status": 401
      }
    },
    {
      "id": "s3",
      "actor": "anonymous",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/locations/nodes",
        "body": {
          "code": "X",
          "name": "X",
          "node_kind": "zone",
          "idempotency_key": "uat-${run_id}-03c"
        }
      },
      "expect_refused": {
        "status": 401
      }
    },
    {
      "id": "s4",
      "actor": "anonymous",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/catalog_items/lots",
        "body": {
          "idempotency_key": "uat-${run_id}-03d"
        }
      },
      "expect_refused": {
        "status": 401
      }
    },
    {
      "id": "s5",
      "actor": "anonymous",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/codes/receive",
        "body": {
          "entries": [
            {
              "value": "X",
              "kind": "barcode"
            }
          ],
          "idempotency_key": "uat-${run_id}-03e"
        }
      },
      "expect_refused": {
        "status": 401
      }
    },
    {
      "id": "s6",
      "actor": "anonymous",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/codes/resolve",
        "body": {
          "value": "UAT-unknown-${run_id}"
        }
      },
      "expect_refused": {
        "status": 401
      }
    },
    {
      "id": "s7",
      "actor": "anonymous",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/codes/labels",
        "body": {
          "code_ids": []
        }
      },
      "expect_refused": {
        "status": 401
      }
    },
    {
      "id": "s8",
      "actor": "admin",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/locations/nodes/00000000-0000-4000-8000-0000000000d1/retire",
        "body": {
          "idempotency_key": "uat-${run_id}-03s8"
        }
      },
      "expect": {
        "status": 404
      }
    }
  ],
  "cleanup": [],
  "tenant": "${tenant}",
  "inputs": [],
  "outputs": {}
}
