{
  "id": "SEC-OLD-08",
  "bp_entry": "BP-STOCK-35",
  "title": "Old address: with the four-eyes switch for counts OFF, a count posts at once; its client id replays the same row",
  "description": "SECURITY (REQ-912, decision 0091 section 9 amended 2026-11-20, D-144 four-eyes switch). The tenant administrator, signed in, switches the four-eyes rule of the quick count approve step OFF with a reason. The phone posts a count of the book balance plus 1: 201 with the count's movement row (quantity = the counted number) at once, the balance is the counted number; the same id and data gives 200 with the same movement id and no second count; the same id with another number is 409. A reversal with a new id brings the balance back. The administrator switches the rule ON again with a reason (an explicit row ON; the behaviour equals the tenant's default ON). The storekeeper may not change the switch (403). Every operation id is a fresh UUID of the run (${uuid1}..${uuid5}, made by the runner), the same on a retry. The key is the input item and place (old-app numbers): an item with no balance anywhere at a place linked to an org unit, so the phone's own receipt of 2 units (s4, reversed in the cleanup) is the only row of the key and the count is not refused for rows of another responsible or lot (the first balance row of qoimeks-qa2 is such a key: 400 'Этот товар на этом месте числится за другим ответственным...', dry run of 2026-11-21). Precondition (UAT assumption, to be confirmed by the process owner): no count order freezes the place and no other walk posts or counts at that key during the run (the checks compare only what this run did). Run this file alone on the tenant: while the switch is OFF every count of every walk posts at once. Cleanup switches the rule ON, reverses the count if the run stopped before the reversal, and revokes the value.",
  "tenant": "${tenant}",
  "inputs": [
    "sku_id",
    "location_id"
  ],
  "dry_run": {
    "tenant": "qoimeks-qa2",
    "actors": {
      "admin": "qoimeks-qa2-admin",
      "storekeeper": "qoimeks-qa2-storekeeper"
    },
    "inputs": {
      "sku_id": "469",
      "location_id": "1"
    },
    "old_base_url": "https://qa.bizdala.com/qoimeks/qoimeks-qa2"
  },
  "steps": [
    {
      "id": "s2",
      "actor": "admin",
      "do": {
        "api": "GET",
        "path": "/api/v1/identity/shared-stock-access"
      },
      "expect": {
        "status": 200,
        "json": {
          "$.enabled": true,
          "$.exists": false
        }
      }
    },
    {
      "id": "s3",
      "actor": "admin",
      "do": {
        "api": "POST",
        "path": "/api/v1/identity/shared-stock-access",
        "body": {}
      },
      "expect": {
        "status": 201
      },
      "save": {
        "shared_created": "yes",
        "shared_access": {
          "secret": "$.value"
        }
      }
    },
    {
      "id": "s4",
      "http_as": "shared_access",
      "do": {
        "api": "POST",
        "path": "/api/movements",
        "body": {
          "kind": "receipt",
          "sku_id": "${sku_id}",
          "location_id": "${location_id}",
          "qty": 2,
          "operator": "UAT ${run_id}",
          "id": "${uuid4}"
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "$.kind": "receipt",
          "$.qty": 2
        }
      },
      "save": {
        "receipt_movement": "$.id"
      }
    },
    {
      "id": "s5",
      "http_as": "shared_access",
      "do": {
        "api": "GET",
        "path": "/api/balances?sku_id=${sku_id}&location_id=${location_id}"
      },
      "expect": {
        "status": 200,
        "json": {
          "$[0].qty": {
            "exists": true
          }
        }
      },
      "save": {
        "b0": "$[0].qty"
      }
    },
    {
      "id": "s6",
      "actor": "storekeeper",
      "do": {
        "api": "PUT",
        "path": "/api/v1/approval-rules/stock_quick_count/approve",
        "body": {
          "four_eyes": false,
          "reason": "UAT probe by a storekeeper"
        }
      },
      "expect_refused": {
        "status": 403
      }
    },
    {
      "id": "s7",
      "actor": "admin",
      "do": {
        "api": "PUT",
        "path": "/api/v1/approval-rules/stock_quick_count/approve",
        "body": {
          "four_eyes": false,
          "reason": "UAT ${run_id}: old-address count with the switch OFF"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "$.four_eyes": false
        }
      },
      "save": {
        "switched_off": "yes"
      }
    },
    {
      "id": "s8",
      "http_as": "shared_access",
      "do": {
        "api": "POST",
        "path": "/api/movements",
        "body": {
          "kind": "adjustment",
          "sku_id": "${sku_id}",
          "location_id": "${location_id}",
          "qty": "${b0 + 1}",
          "operator": "UAT ${run_id}",
          "id": "${uuid1}"
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "$.kind": "adjustment",
          "$.qty": "${b0 + 1}"
        }
      },
      "save": {
        "count_movement": "$.id"
      }
    },
    {
      "id": "s9",
      "http_as": "shared_access",
      "do": {
        "api": "POST",
        "path": "/api/movements",
        "body": {
          "kind": "adjustment",
          "sku_id": "${sku_id}",
          "location_id": "${location_id}",
          "qty": "${b0 + 1}",
          "operator": "UAT ${run_id}",
          "id": "${uuid1}"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "$.id": "${count_movement}"
        }
      }
    },
    {
      "id": "s10",
      "http_as": "shared_access",
      "do": {
        "api": "POST",
        "path": "/api/movements",
        "body": {
          "kind": "adjustment",
          "sku_id": "${sku_id}",
          "location_id": "${location_id}",
          "qty": "${b0 + 2}",
          "operator": "UAT ${run_id}",
          "id": "${uuid1}"
        }
      },
      "expect": {
        "status": 409,
        "json": {
          "$.error": "this operation was already posted with different data"
        }
      }
    },
    {
      "id": "s11",
      "http_as": "shared_access",
      "do": {
        "api": "GET",
        "path": "/api/balances?sku_id=${sku_id}&location_id=${location_id}"
      },
      "expect": {
        "status": 200,
        "json": {
          "$[0].qty": {
            "equals": "${b0 + 1}",
            "default": "0"
          }
        }
      }
    },
    {
      "id": "s12",
      "http_as": "shared_access",
      "do": {
        "api": "POST",
        "path": "/api/movements/${count_movement}/reverse",
        "body": {
          "operator": "UAT ${run_id}",
          "id": "${uuid2}"
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "$.reverses": "${count_movement}"
        }
      }
    },
    {
      "id": "s13",
      "http_as": "shared_access",
      "do": {
        "api": "GET",
        "path": "/api/balances?sku_id=${sku_id}&location_id=${location_id}"
      },
      "expect": {
        "status": 200,
        "json": {
          "$[0].qty": {
            "equals": "${b0}",
            "default": "0"
          }
        }
      }
    },
    {
      "id": "s14",
      "actor": "admin",
      "do": {
        "api": "PUT",
        "path": "/api/v1/approval-rules/stock_quick_count/approve",
        "body": {
          "four_eyes": true,
          "reason": "UAT ${run_id}: switch restored ON after the old-address count"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "$.four_eyes": true
        }
      }
    }
  ],
  "outputs": {},
  "cleanup": [
    {
      "id": "c1",
      "actor": "admin",
      "requires": [
        "switched_off"
      ],
      "do": {
        "api": "PUT",
        "path": "/api/v1/approval-rules/stock_quick_count/approve",
        "body": {
          "four_eyes": true,
          "reason": "UAT cleanup: switch restored ON"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "$.four_eyes": true
        }
      }
    },
    {
      "id": "c8",
      "http_as": "shared_access",
      "requires": [
        "count_movement"
      ],
      "do": {
        "api": "POST",
        "path": "/api/movements/${count_movement}/reverse",
        "body": {
          "operator": "UAT ${run_id}",
          "id": "${uuid2}"
        }
      },
      "expect": {
        "status": [
          200,
          201
        ]
      }
    },
    {
      "id": "c7",
      "http_as": "shared_access",
      "requires": [
        "receipt_movement"
      ],
      "do": {
        "api": "POST",
        "path": "/api/movements/${receipt_movement}/reverse",
        "body": {
          "operator": "UAT ${run_id}",
          "id": "${uuid5}"
        }
      },
      "expect": {
        "status": [
          200,
          201
        ]
      }
    },
    {
      "id": "c9",
      "actor": "admin",
      "requires": [
        "shared_created"
      ],
      "do": {
        "api": "DELETE",
        "path": "/api/v1/identity/shared-stock-access"
      },
      "expect": {
        "status": [
          204,
          404
        ]
      }
    }
  ]
}
