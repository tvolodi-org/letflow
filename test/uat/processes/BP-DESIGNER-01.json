{
  "id": "BP-DESIGNER-01",
  "bp_entry": "BP-DESIGNER-01",
  "title": "Draft, change, activate and retire a process definition",
  "description": "A tenant administrator drafts a process (start, one human task, end) under a name made from the run id, checks it, replaces it, finds it, activates it, and sees that a second activation and a change to the active version are refused. The cleanup deletes the definition: an active one is deprecated and archived (the row stays, archived, and cannot be removed); a draft is removed. Residue: one archived definition named uat-designer-<run id>.",
  "tenant": "${tenant}",
  "inputs": [],
  "defaults": {
    "version": "1.0.0"
  },
  "dry_run": {
    "tenant": "qoimeks-qa2",
    "actors": {
      "admin": "qoimeks-qa2-admin",
      "storekeeper": "qoimeks-qa2-storekeeper"
    },
    "inputs": {}
  },
  "steps": [
    {
      "id": "s1",
      "actor": "admin",
      "do": {
        "api": "POST",
        "path": "/api/v1/definitions",
        "body": {
          "name": "uat-designer-${run_id}",
          "version": "${version}",
          "description": "UAT ${run_id}",
          "graph": {
            "nodes": [
              {
                "id": "start",
                "node_type": "START"
              },
              {
                "id": "task",
                "node_type": "HUMAN_TASK",
                "attributes": {
                  "role": "approver"
                }
              },
              {
                "id": "end",
                "node_type": "END"
              }
            ],
            "edges": [
              {
                "id": "e1",
                "source": "start",
                "target": "task"
              },
              {
                "id": "e2",
                "source": "task",
                "target": "end"
              }
            ]
          }
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "status": "DRAFT"
        }
      },
      "save": {
        "def_id": "$.id",
        "def_name": "$.name"
      }
    },
    {
      "id": "s2",
      "actor": "admin",
      "do": {
        "api": "POST",
        "path": "/api/v1/definitions/${def_id}/validate"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "id": "s3",
      "actor": "admin",
      "do": {
        "api": "PUT",
        "path": "/api/v1/definitions/${def_id}",
        "body": {
          "name": "uat-designer-${run_id}",
          "version": "1.0.1",
          "graph": {
            "nodes": [
              {
                "id": "start",
                "node_type": "START"
              },
              {
                "id": "task",
                "node_type": "HUMAN_TASK",
                "attributes": {
                  "role": "approver"
                }
              },
              {
                "id": "end",
                "node_type": "END"
              }
            ],
            "edges": [
              {
                "id": "e1",
                "source": "start",
                "target": "task"
              },
              {
                "id": "e2",
                "source": "task",
                "target": "end"
              }
            ]
          }
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "version": "1.0.1",
          "status": "DRAFT"
        }
      }
    },
    {
      "id": "s4",
      "actor": "admin",
      "do": {
        "api": "GET",
        "path": "/api/v1/definitions/${def_id}"
      },
      "expect": {
        "status": 200,
        "json": {
          "id": "${def_id}",
          "status": "DRAFT"
        }
      }
    },
    {
      "id": "s5",
      "actor": "admin",
      "do": {
        "api": "POST",
        "path": "/api/v1/definitions/${def_id}/activate"
      },
      "expect": {
        "status": 200,
        "json": {
          "status": "ACTIVE"
        }
      }
    },
    {
      "id": "s6",
      "actor": "admin",
      "do": {
        "api": "POST",
        "path": "/api/v1/definitions/${def_id}/activate"
      },
      "expect_refused": {
        "status": 409
      }
    },
    {
      "id": "s7",
      "actor": "admin",
      "do": {
        "api": "PUT",
        "path": "/api/v1/definitions/${def_id}",
        "body": {
          "name": "uat-designer-${run_id}",
          "version": "1.0.2",
          "graph": {
            "nodes": [
              {
                "id": "start",
                "node_type": "START"
              },
              {
                "id": "task",
                "node_type": "HUMAN_TASK",
                "attributes": {
                  "role": "approver"
                }
              },
              {
                "id": "end",
                "node_type": "END"
              }
            ],
            "edges": [
              {
                "id": "e1",
                "source": "start",
                "target": "task"
              },
              {
                "id": "e2",
                "source": "task",
                "target": "end"
              }
            ]
          }
        }
      },
      "expect_refused": {
        "status": 409
      }
    },
    {
      "id": "s8",
      "actor": "admin",
      "do": {
        "api": "GET",
        "path": "/api/v1/definitions/active/${def_name}"
      },
      "expect": {
        "status": 200,
        "json": {
          "id": "${def_id}"
        }
      }
    }
  ],
  "outputs": {
    "definition_id": "${def_id}"
  },
  "cleanup": [
    {
      "id": "c1",
      "actor": "admin",
      "requires": [
        "def_id"
      ],
      "do": {
        "api": "DELETE",
        "path": "/api/v1/definitions/${def_id}"
      },
      "expect": {
        "status": [
          200,
          204
        ]
      }
    }
  ]
}
