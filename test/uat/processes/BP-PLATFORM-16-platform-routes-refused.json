{
  "id": "BP-PLATFORM-16",
  "bp_entry": "BP-PLATFORM-16",
  "title": "A tenant administrator is refused on every platform route",
  "description": "SECURITY. A tenant administrator of a company tenant tries the platform routes (tenant registry, onboarding, backup status, module rollouts, platform migrations, event retention, service catalogue, problem reports): each is refused with 403, the answer for the administrator's own slug is the same as for an unknown slug, and the promotion route answers a foreign tenant id with the zero-detail 404 (the same as an unknown id). Only reads and harmless write probes are used (an unknown slug, empty bodies, an unused id); nothing is created or changed, so there is nothing to clean up.",
  "tenant": "${tenant}",
  "inputs": [],
  "dry_run": {
    "tenant": "qoimeks-qa2",
    "actors": {
      "admin": "qoimeks-qa2-admin"
    },
    "inputs": {}
  },
  "steps": [
    {
      "id": "s1",
      "actor": "admin",
      "do": {
        "api": "GET",
        "path": "/api/v1/tenants"
      },
      "expect_refused": {
        "status": 403
      }
    },
