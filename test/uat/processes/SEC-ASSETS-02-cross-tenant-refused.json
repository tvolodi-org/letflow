        }
      }
    },
    {
      "id": "s10",
      "actor": "sss-rehearsal2-admin",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/assets/documents/${home_stock_doc}/reverse",
        "body": {
          "reason_code": "other",
          "reason_text": "UAT ${run_id} cross-tenant probe"
        }
      },
      "expect": {
        "status": 404,
        "json": {
          "detail": "${nf_detail}",
          "title": "${nf_title}"
        }
      }
    },
    {
      "id": "s11",
      "actor": "sss-rehearsal2-admin",
      "do": {
        "assert_only": {
          "path": "/api/v1/modules/stock/documents/${home_stock_doc}"
        }
      },
      "expect": {
        "status": 404,
        "json": {
