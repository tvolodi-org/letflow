        }
      },
      "expect": {
        "status": 200,
        "json": {
          "$.rows[0].id": {
            "exists": true
          }
        }
      },
      "save": {
        "home_stock_doc": "$.rows[0].id"
      }
    },
    {
      "id": "s3",
      "actor": "sss-rehearsal2-admin",
      "do": {
        "assert_only": {
          "path": "/api/v1/modules/stock/documents?limit=1"
        }
      },
