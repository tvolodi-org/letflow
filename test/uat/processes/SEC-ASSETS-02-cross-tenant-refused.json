      }
    },
    {
      "id": "s4",
      "actor": "admin",
      "do": {
        "assert_only": {
          "path": "/api/v1/modules/assets/documents/${foreign_doc}"
        }
      },
      "expect": {
        "status": 404,
        "json": {
          "detail": "${nf_detail}",
          "title": "${nf_title}"
        }
      }
    },
    {
      "id": "s5",
      "actor": "admin",
      "do": {
