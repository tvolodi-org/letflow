      "expect": {
        "status": 404,
        "json": {
          "detail": "${nf_detail}",
          "title": "${nf_title}"
        }
      }
    },
    {
      "id": "s8",
      "actor": "sss-rehearsal2-admin",
      "do": {
        "assert_only": {
          "path": "/api/v1/modules/assets/documents"
        }
      },
      "expect": {
        "status": 404,
        "json": {
          "detail": "${nf_detail}",
          "title": "${nf_title}"
        }
      }
    },
    {
      "id": "s9",
