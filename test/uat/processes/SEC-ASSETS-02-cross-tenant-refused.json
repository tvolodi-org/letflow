        "path": "/api/v1/modules/assets/documents/${foreign_doc}/reverse",
        "body": {
          "reason_code": "other",
          "reason_text": "UAT ${run_id} cross-tenant probe"
        }
      },
      "expect": {
        "status": 404,
        "json": {
          "detail": "${nf_detail}",
          "title": "${nf_title}"
        }
      }
    },
    {
