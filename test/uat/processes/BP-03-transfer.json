{
  "id": "BP-03",
  "bp_entry": "BP-STOCK-04",
  "title": "Transfer between places",
  "description": "A storekeeper first tries a transfer whose from side equals its to side (refused, nothing saved). Then the storekeeper creates a transfer of `quantity` units (default 2) of one item from place A to place B of the same org unit and responsible person, issues it, and an administrator claims and completes the Post task. One document and one ledger entry result: the balance at A falls by the quantity, the balance at B grows by the same quantity. The cleanup reverses the document (reason fields required by the API) and completes the Reverse task, so both balances return to their start. Needs a source place with at least `quantity` units of the item. The second_place fixture supplies place_from (the input place) and an active second place linked to the same org unit.",
  "tenant": "${tenant}",
  "fixtures": ["second_place"],
  "inputs": [
    "item",
    "place",
    "org_unit",
    "responsible"
  ],
  "defaults": {
    "quantity": "2"
  },
  "dry_run": {
    "tenant": "qoimeks-qa2",
    "actors": {
      "admin": "qoimeks-qa2-admin",
      "storekeeper": "qoimeks-qa2-storekeeper"
    },
    "inputs": {
      "item": "005fb8be-cf30-4e8f-a113-acd5abf7f9b4",
      "place": "fb5ba528-6d0c-4298-aec7-b8ee58e3a9f2",
      "org_unit": "e83ea09f-c216-459b-9081-d5db82a7d917",
      "responsible": "bbc4b1fa-0f65-4528-b933-815681680dfc"
    }
  },
  "steps": [
    {
      "id": "s0",
      "actor": "storekeeper",
      "do": {
        "api": "GET",
        "path": "/api/v1/modules/stock/balances?sku=${item}&location=${place_from}&org_unit=${org_unit}&responsible=${responsible}"
      },
      "expect": {
        "status": 200
      },
      "save": {
        "balance_from_before": {
          "pick": "$.rows[0].quantity",
          "default": "0"
        },
        "uom": {
          "pick": "$.rows[0].unit_ref",
          "if_unset": true
        }
      }
    },
    {
      "id": "s1",
      "actor": "storekeeper",
      "do": {
        "api": "GET",
        "path": "/api/v1/modules/stock/balances?sku=${item}&location=${place_to}&org_unit=${org_unit}&responsible=${responsible}"
      },
      "expect": {
        "status": 200
      },
      "save": {
        "balance_to_before": {
          "pick": "$.rows[0].quantity",
          "default": "0"
        }
      }
    },
    {
      "id": "s2",
      "actor": "storekeeper",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/stock/documents",
        "body": {
          "kind": "transfer",
          "org_unit_id": "${org_unit}",
          "from_location_id": "${place_from}",
          "from_responsible_id": "${responsible}",
          "to_org_unit_id": "${org_unit}",
          "to_location_id": "${place_from}",
          "to_responsible_id": "${responsible}",
          "event_time": "${now_utc}",
          "note": "UAT ${run_id}",
          "lines": [
            {
              "catalog_item_id": "${item}",
              "catalog_uom_id": "${uom}",
              "quantity": "${quantity}"
            }
          ]
        }
      },
      "expect_refused": {
        "status": 422,
        "code": "sides_equal"
      }
    },
    {
      "id": "s3",
      "actor": "storekeeper",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/stock/documents",
        "body": {
          "kind": "transfer",
          "org_unit_id": "${org_unit}",
          "from_location_id": "${place_from}",
          "from_responsible_id": "${responsible}",
          "to_org_unit_id": "${org_unit}",
          "to_location_id": "${place_to}",
          "to_responsible_id": "${responsible}",
          "event_time": "${now_utc}",
          "note": "UAT ${run_id}",
          "lines": [
            {
              "catalog_item_id": "${item}",
              "catalog_uom_id": "${uom}",
              "quantity": "${quantity}"
            }
          ]
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "state": "draft"
        }
      },
      "save": {
        "doc_id": "$.id"
      }
    },
    {
      "id": "s4",
      "actor": "storekeeper",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/stock/documents/${doc_id}/issue"
      },
      "expect": {
        "status": 200,
        "json": {
          "state": "issued"
        }
      }
    },
    {
      "id": "s5",
      "actor": "admin",
      "do": {
        "wait_task": {
          "for_document": "${doc_id}",
          "step": "post",
          "within_s": 30
        },
        "claim": true,
        "complete": {
          "body": {}
        }
      },
      "expect": {
        "status": 200
      },
      "save": {
        "posted_doc_id": "${doc_id}"
      }
    },
    {
      "id": "s6",
      "actor": "admin",
      "do": {
        "api": "GET",
        "path": "/api/v1/modules/stock/balances?sku=${item}&location=${place_from}&org_unit=${org_unit}&responsible=${responsible}"
      },
      "expect": {
        "status": 200,
        "json": {
          "$.rows[0].quantity": {
            "equals": "${balance_from_before - quantity}"
          }
        }
      },
      "save": {
        "balance_from_after": "$.rows[0].quantity"
      }
    },
    {
      "id": "s7",
      "actor": "admin",
      "do": {
        "api": "GET",
        "path": "/api/v1/modules/stock/balances?sku=${item}&location=${place_to}&org_unit=${org_unit}&responsible=${responsible}"
      },
      "expect": {
        "status": 200,
        "json": {
          "$.rows[0].quantity": {
            "equals": "${balance_to_before + quantity}"
          }
        }
      },
      "save": {
        "balance_to_after": "$.rows[0].quantity"
      }
    },
    {
      "id": "s8",
      "actor": "admin",
      "do": {
        "api": "GET",
        "path": "/api/v1/modules/stock/documents/${doc_id}"
      },
      "expect": {
        "status": 200,
        "json": {
          "state": "posted",
          "entry_id": {
            "exists": true
          }
        }
      },
      "save": {
        "entry_id": "$.entry_id"
      }
    }
  ],
  "outputs": {
    "transfer_doc_id": "${doc_id}",
    "transfer_entry_id": "${entry_id}",
    "balance_from_after": "${balance_from_after}",
    "balance_to_after": "${balance_to_after}"
  },
  "cleanup": [
    {
      "id": "c1",
      "actor": "admin",
      "requires": [
        "posted_doc_id"
      ],
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/stock/documents/${posted_doc_id}/reverse",
        "body": {
          "reason_code": "other",
          "reason_text": "UAT ${run_id} cleanup of BP-03"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "id": "c2",
      "actor": "admin",
      "requires": [
        "posted_doc_id"
      ],
      "do": {
        "wait_task": {
          "for_document": "${posted_doc_id}",
          "step": "reverse",
          "within_s": 30
        },
        "claim": true,
        "complete": {
          "body": {}
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "id": "c3",
      "actor": "admin",
      "requires": [
        "posted_doc_id",
        "balance_from_before"
      ],
      "do": {
        "api": "GET",
        "path": "/api/v1/modules/stock/balances?sku=${item}&location=${place_from}&org_unit=${org_unit}&responsible=${responsible}"
      },
      "expect": {
        "status": 200,
        "json": {
          "$.rows[0].quantity": {
            "equals": "${balance_from_before}",
            "default": "0"
          }
        }
      }
    },
    {
      "id": "c4",
      "actor": "admin",
      "requires": [
        "posted_doc_id",
        "balance_to_before"
      ],
      "do": {
        "api": "GET",
        "path": "/api/v1/modules/stock/balances?sku=${item}&location=${place_to}&org_unit=${org_unit}&responsible=${responsible}"
      },
      "expect": {
        "status": 200,
        "json": {
          "$.rows[0].quantity": {
            "equals": "${balance_to_before}",
            "default": "0"
          }
        }
      }
    }
  ]
}
