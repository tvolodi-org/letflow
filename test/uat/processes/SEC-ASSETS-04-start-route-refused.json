      },
      "expect": {
        "status": 200,
        "json": {
          "name": "assets_kind_change",
          "owner_module": "assets",
          "status": "ACTIVE"
        }
      },
      "save": {
        "kind_change_def_id": "$.id"
      }
    },
    {
