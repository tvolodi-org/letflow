{
  "id": "BP-06",
  "bp_entry": "BP-STOCK-13",
  "title": "Stock load from Excel: the parts a JSON runner can play (download, refusals, list, nothing written)",
  "description": "The administrator downloads the whole current stock as an Excel workbook; the storekeeper reads the list of earlier loads. Then the doors of the load are tried the way a person at the screen or a wrong caller meets them, and each must be refused with its stable reason and change nothing: the check and the load without an organisation unit, with an unknown unit and without a workbook; the load and the cancel by the storekeeper (a role without the Excel-load permission and without the approval permission); the cancel without a reason and of a load that does not exist. At the end the newest entry of the list of loads is the same as at the start. Nothing is created, so there is nothing to clean up. NOT PLAYED HERE (runner gap, see the run notes): the steps that send a workbook file (check with remarks, load, approve the load's task, balances equal the file, cancel the load), because the runner sends only JSON bodies and cannot upload a file; they stay in the prose group qoimeks-import until the runner has a file-body step.",
  "tenant": "${tenant}",
  "inputs": ["org_unit"],
  "dry_run": {
    "tenant": "sss-rehearsal2",
    "actors": {"admin": "sss-rehearsal2-admin", "storekeeper": "sss-rehearsal2-storekeeper"},
    "inputs": {
      "org_unit": "c79c1b3d-0be8-4f0e-bf81-58744c9fa660"
    }
  },
  "steps": [
    {
      "id": "s0",
      "actor": "admin",
      "do": {"api": "GET", "path": "/api/v1/modules/stock/stock-workbook"},
      "expect": {"status": 200}
    },
    {
      "id": "s1",
      "actor": "storekeeper",
      "do": {"api": "GET", "path": "/api/v1/modules/stock/stock-workbook/imports"},
      "expect": {"status": 200},
      "save": {"first_load_before": {"pick": "$.rows[0].document_id", "default": "none"}}
    },
    {
      "id": "s2",
      "actor": "storekeeper",
      "do": {"api": "POST", "path": "/api/v1/modules/stock/stock-workbook/check", "body": {}},
      "expect_refused": {"status": 422, "code": "org_unit_required"}
    },
    {
      "id": "s3",
      "actor": "admin",
      "do": {"api": "POST", "path": "/api/v1/modules/stock/stock-workbook/check?org_unit_id=00000000-0000-4000-8000-000000000000", "body": {}},
      "expect_refused": {"status": 422, "code": "org_unit_not_found"}
    },
    {
      "id": "s4",
      "actor": "admin",
      "do": {"api": "POST", "path": "/api/v1/modules/stock/stock-workbook/check?org_unit_id=${org_unit}", "body": {}},
      "expect_refused": {"status": 422, "code": "xlsx_unreadable"}
    },
    {
      "id": "s5",
      "actor": "storekeeper",
      "do": {"api": "POST", "path": "/api/v1/modules/stock/stock-workbook/apply?org_unit_id=${org_unit}", "body": {}},
      "expect_refused": {"status": 403}
    },
    {
      "id": "s6",
      "actor": "admin",
      "do": {"api": "POST", "path": "/api/v1/modules/stock/stock-workbook/apply?org_unit_id=${org_unit}", "body": {}},
      "expect_refused": {"status": 422, "code": "xlsx_unreadable"}
    },
    {
      "id": "s7",
      "actor": "storekeeper",
      "do": {"api": "POST", "path": "/api/v1/modules/stock/stock-workbook/imports/00000000-0000-4000-8000-000000000000/cancel", "body": {"reason": "UAT ${run_id} refusal check"}},
      "expect_refused": {"status": 403}
    },
    {
      "id": "s8",
      "actor": "admin",
      "do": {"api": "POST", "path": "/api/v1/modules/stock/stock-workbook/imports/00000000-0000-4000-8000-000000000000/cancel", "body": {}},
      "expect_refused": {"status": 422, "code": "reason_required"}
    },
    {
      "id": "s9",
      "actor": "admin",
      "do": {"api": "POST", "path": "/api/v1/modules/stock/stock-workbook/imports/00000000-0000-4000-8000-000000000000/cancel", "body": {"reason": "UAT ${run_id} unknown load"}},
      "expect_refused": {"status": 404}
    },
    {
      "id": "s10",
      "actor": "storekeeper",
      "do": {"api": "GET", "path": "/api/v1/modules/stock/stock-workbook/imports"},
      "expect": {"status": 200, "json": {"$.rows[0].document_id": {"equals": "${first_load_before}", "default": "none"}}}
    }
  ],
  "outputs": {
    "first_load_id": "${first_load_before}"
  },
  "cleanup": []
}
