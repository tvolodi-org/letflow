{
  "id": "BP-04",
  "bp_entry": "BP-STOCK-08",
  "title": "Count: quick count of one item at one place (count rule OFF)",
  "description": "A storekeeper counts one more unit than the book quantity of one item at one place. The tenant's count rule stock_quick_count/approve is stored OFF (the default of a fresh tenant), so the system approves the counter's own count in the same call: the document is posted at once, shows book, counted and a difference of 1, and the balance becomes exactly the counted quantity (not the book plus the counted). A count with a missing note for the reason Other is refused and changes nothing. The cleanup reverses the count document (an administrator completes the Reverse task) so the balance returns to the start. Precondition: the item has a balance row at the place for the responsible person (the unit is read from it) and no other responsible person holds stock of the item at that place; no count order is open over the place. If the rule were ON, the first answer would be an issued document: the walk then fails on purpose (the rule is part of the tenant state, not changed here) and leaves that one issued count for the administrator to cancel in My Tasks.",
  "tenant": "${tenant}",
  "inputs": ["item", "place", "org_unit", "responsible"],
  "defaults": {"reason_text": "UAT quick count"},
  "dry_run": {
    "tenant": "sss-rehearsal2",
    "actors": {"admin": "sss-rehearsal2-admin", "storekeeper": "sss-rehearsal2-storekeeper"},
    "inputs": {
      "item": "208ee14a-b5c7-4ec2-b905-b0391001fd98",
      "place": "925d46bf-af76-4940-867d-9f4521536767",
      "org_unit": "c79c1b3d-0be8-4f0e-bf81-58744c9fa660",
      "responsible": "58d53f0f-90ea-4532-8079-8f4e5263e8b8"
    }
  },
  "steps": [
    {
      "id": "s0",
      "actor": "storekeeper",
      "do": {"api": "GET", "path": "/api/v1/modules/stock/balances?sku=${item}&location=${place}&org_unit=${org_unit}&responsible=${responsible}"},
      "expect": {"status": 200},
      "save": {
        "balance_before": {"pick": "$.rows[0].quantity", "default": "0"},
        "uom": {"pick": "$.rows[0].unit_ref", "if_unset": true}
      }
    },
    {
      "id": "s1",
      "actor": "storekeeper",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/stock/quick-counts",
        "body": {
          "org_unit_id": "${org_unit}",
          "location_id": "${place}",
          "responsible_id": "${responsible}",
          "catalog_item_id": "${item}",
          "catalog_uom_id": "${uom}",
          "counted_quantity": "${balance_before + 1}",
          "reason_code": "other",
          "reason_text": "UAT ${run_id}"
        }
      },
      "expect": {"status": 201, "json": {"state": "posted"}},
      "save": {"doc_id": "$.id", "posted_doc_id": "$.id"}
    },
    {
      "id": "s2",
      "actor": "storekeeper",
      "do": {"api": "GET", "path": "/api/v1/modules/stock/documents/${doc_id}"},
      "expect": {
        "status": 200,
        "json": {
          "state": "posted",
          "$.lines[0].book_quantity": {"equals": "${balance_before}"},
          "$.lines[0].counted_quantity": {"equals": "${balance_before + 1}"},
          "$.lines[0].difference": {"equals": "1"},
          "entry_id": {"exists": true}
        }
      },
      "save": {"entry_id": "$.entry_id"}
    },
    {
      "id": "s3",
      "actor": "admin",
      "do": {"api": "GET", "path": "/api/v1/modules/stock/balances?sku=${item}&location=${place}&org_unit=${org_unit}&responsible=${responsible}"},
      "expect": {"status": 200, "json": {"$.rows[0].quantity": {"equals": "${balance_before + 1}"}}},
      "save": {"balance_after": "$.rows[0].quantity"}
    },
    {
      "id": "s4",
      "actor": "storekeeper",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/stock/quick-counts",
        "body": {
          "org_unit_id": "${org_unit}",
          "location_id": "${place}",
          "responsible_id": "${responsible}",
          "catalog_item_id": "${item}",
          "catalog_uom_id": "${uom}",
          "counted_quantity": "${balance_before + 5}",
          "reason_code": "other"
        }
      },
      "expect_refused": {"status": 422, "code": "reason_invalid"}
    },
    {
      "id": "s5",
      "actor": "admin",
      "do": {"assert_only": {"path": "/api/v1/modules/stock/balances?sku=${item}&location=${place}&org_unit=${org_unit}&responsible=${responsible}"}},
      "expect": {"status": 200, "json": {"$.rows[0].quantity": {"equals": "${balance_after}"}}}
    }
  ],
  "outputs": {
    "count_doc_id": "${doc_id}",
    "count_entry_id": "${entry_id}",
    "difference": "1",
    "balance_after": "${balance_after}"
  },
  "cleanup": [
    {
      "id": "c1",
      "actor": "admin",
      "requires": ["posted_doc_id"],
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/stock/documents/${posted_doc_id}/reverse",
        "body": {"reason_code": "other", "reason_text": "UAT ${run_id} cleanup of BP-04"}
      },
      "expect": {"status": 200}
    },
    {
      "id": "c2",
      "actor": "admin",
      "requires": ["posted_doc_id"],
      "do": {
        "wait_task": {"for_document": "${posted_doc_id}", "step": "reverse", "within_s": 30},
        "claim": true,
        "complete": {"body": {}}
      },
      "expect": {"status": 200}
    },
    {
      "id": "c3",
      "actor": "admin",
      "requires": ["posted_doc_id"],
      "do": {"api": "GET", "path": "/api/v1/modules/stock/balances?sku=${item}&location=${place}&org_unit=${org_unit}&responsible=${responsible}"},
      "expect": {"status": 200, "json": {"$.rows[0].quantity": {"equals": "${balance_before}", "default": "0"}}},
      "save": {"balance_end": {"pick": "$.rows[0].quantity", "default": "0"}}
    }
  ]
}
