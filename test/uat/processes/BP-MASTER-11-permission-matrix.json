{
  "id": "BP-MASTER-11",
  "bp_entry": "BP-MASTER-11",
  "title": "Permission matrix of the master data routes: the storekeeper may not write",
  "description": "The storekeeper (STOREKEEPER) calls every kind of write route of org, locations, catalog lots and codes and is refused with 403 each time; nothing is written. The two reads the role holds (scan lookup, label print) are not refused: an unknown value is the 404 of an unknown code, an empty label list is a 422 of the body (the permission passed). Needs the four modules installed (on a tenant without a module its routes answer 404).",
  "tenant": "${tenant}",
  "inputs": [],
  "steps": [
    {
      "id": "s1",
      "actor": "storekeeper",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/org/legal-entities",
        "body": {
          "code": "X",
          "name": "X",
          "bin": "123456789012",
          "idempotency_key": "uat-${run_id}-11s1"
        }
      },
      "expect_refused": {
        "status": 403
      }
    },
