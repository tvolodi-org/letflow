{
  "id": "BP-EXAM-01",
  "bp_entry": "BP-EXAM-01",
  "title": "Exam: write the question bank",
  "description": "The exam author (tenant administrator) builds a small question bank: two categories (one under the other), a question, and a new version of that question. The system refuses a category that is its own parent or its own ancestor, a parent that does not exist, a new question version whose number does not rise, a second child on one question version, and the deletion of a category or question that still has a child. The author then changes the question as a whole and removes everything again, leaf first; the cleanup repeats the removals if a step failed, so the tenant is left as found. Only the administrator acts: the refusal of a role without the authoring permission is BP-EXAM-07. Dry-run scope: the answer option steps are NOT in this script either: on the dry-run tenant the administrator may not write the restricted field is_correct (403 restricted fields), so an option cannot be created there.  the parent/lineage steps (category tree, parent_cycle, parent_not_found, category_has_children, version_not_increasing, lineage_branch, question_has_children) are NOT in this script: the active category definition on the dry-run tenant does not yet declare parent_id (dry run answered additionalProperties on parent_id), so they wait for the parent_id definition rollout on that tenant.",
  "tenant": "${tenant}",
  "inputs": [],
  "defaults": {
    "missing_id": "00000000-0000-4000-8000-000000000000"
  },
  "dry_run": {
    "tenant": "bilimbaga",
    "actors": {
      "admin": "actor-bilimbaga-admin"
    },
    "inputs": {}
  },
  "steps": [
    {
      "id": "s1",
      "actor": "admin",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/exam/authoring/category",
        "body": {
          "field_values": {
            "name": {
              "en": "UAT ${run_id} category"
            },
            "sort_order": 0
          }
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "$.record_id": {
            "exists": true
          }
        }
      },
      "save": {
        "cat_a": "$.record_id"
      }
    },
    {
      "id": "s2",
      "actor": "admin",
      "do": {
        "api": "POST",
        "path": "/api/v1/modules/exam/authoring/question",
        "body": {
          "field_values": {
            "category_id": "${cat_a}",
            "difficulty": "easy",
            "type": "single",
            "default_locale": "en",
            "status": "draft",
            "version": 1,
            "stem": {
              "en": "UAT ${run_id} question"
            }
          }
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "$.record_id": {
            "exists": true
          }
        }
      },
      "save": {
        "q1": "$.record_id"
      }
    },
    {
      "id": "s3",
      "actor": "admin",
      "do": {
        "api": "PUT",
        "path": "/api/v1/modules/exam/authoring/question/${q1}",
        "body": {
          "field_values": {
            "category_id": "${cat_a}",
            "difficulty": "easy",
            "type": "single",
            "default_locale": "en",
            "status": "draft",
            "version": 1,
            "stem": {
              "en": "UAT ${run_id} question changed"
            }
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "id": "s4",
      "actor": "admin",
      "do": {
        "api": "DELETE",
        "path": "/api/v1/modules/exam/authoring/question/${q1}"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "id": "s5",
      "actor": "admin",
      "do": {
        "api": "DELETE",
        "path": "/api/v1/modules/exam/authoring/category/${cat_a}"
      },
      "expect": {
        "status": 200
      }
    }
  ],
  "outputs": {},
  "cleanup": [
    {
      "id": "c1",
      "actor": "admin",
      "requires": [
        "q1"
      ],
      "do": {
        "api": "DELETE",
        "path": "/api/v1/modules/exam/authoring/question/${q1}"
      },
      "expect": {
        "status": [
          200,
          404,
          409,
          422
        ]
      }
    },
    {
      "id": "c2",
      "actor": "admin",
      "requires": [
        "cat_a"
      ],
      "do": {
        "api": "DELETE",
        "path": "/api/v1/modules/exam/authoring/category/${cat_a}"
      },
      "expect": {
        "status": [
          200,
          404,
          409,
          422
        ]
      }
    }
  ]
}
