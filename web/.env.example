# Letflow frontend — environment template
#
# Copy to `web/.env.local` (gitignored) and adjust. Every variable here is
# optional: the value shown is the built-in default that applies when the
# variable is unset. Nothing in this file is a secret.
#
# `VITE_*` variables are read by Vite and inlined into the browser bundle —
# never put a real credential in one. `E2E_*` variables are read by
# Playwright at test time and stay server-side.

# ── API ──────────────────────────────────────────────────────────────────────
# Base URL the SPA calls. Empty string means "same origin", which is what the
# `vite dev` proxy below relies on. Point this at Letflow's Plug/Bandit server.
VITE_API_BASE_URL=http://localhost:4000

# Dev-server port for `npm run dev`.
VITE_PORT=5173

# ── OIDC (Keycloak) ──────────────────────────────────────────────────────────
# Authority is resolved per tenant at runtime (see src/auth/tenantConfig.ts);
# these are the fallbacks used before a tenant is resolved.
VITE_OIDC_AUTHORITY=http://localhost:8082/realms/bpm-default
VITE_OIDC_CLIENT_ID=letflow-web

# ── Email-first login (REQ-438) ──────────────────────────────────────────────
# Shows the credential-free email-first screen at /login when no realm is known.
# OFF unless the value is exactly `true`; keep it off in every committed non-dev
# env. Enabling it outside dev is gated on the backend enablement gate (REQ-444),
# the server mount switch and trusted-proxy config (REQ-437, REQ-439).
VITE_EMAIL_FIRST_LOGIN=false

# ── Module uninstall screen (REQ-630) ────────────────────────────────────────
# Shows the Module lifecycle admin page and its nav entry. OFF unless the value is
# exactly `true`; visibility only, the server flag still decides every call.
VITE_MODULES_UNINSTALL_ENABLED=false

# ── Polling / thresholds ─────────────────────────────────────────────────────
# The SPA has no WebSocket/SSE transport; freshness comes from polling.
VITE_POLL_INTERVAL_MS=10000
VITE_HEALTH_POLL_INTERVAL_MS=30000
# DLQ depth at which the app shell shows an alert badge.
VITE_DLQ_ALERT_THRESHOLD=10

# ── Playwright e2e (not shipped to the browser) ──────────────────────────────
E2E_BASE_URL=http://127.0.0.1:4173
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=
