{
  "name": "letflow-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "npm run type-check && npm run lint && npm run test && npm run guards",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc -b tsconfig.json",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run --passWithNoTests --exclude \"tests/e2e/**\" --exclude \"tests/guards/**\"",
    "test:watch": "vitest --exclude \"tests/e2e/**\" --exclude \"tests/guards/**\"",
    "test:coverage": "vitest run --coverage --exclude \"tests/e2e/**\" --exclude \"tests/guards/**\"",
    "guards": "vitest run tests/guards/meta-control.spec.ts tests/guards/source-scan.spec.ts tests/guards/bundle-scan.spec.ts tests/guards/role-set.spec.ts tests/guards/no-role-literals.spec.ts tests/guards/token-scan.spec.ts --reporter=verbose",
    "test:e2e": "playwright test --config=playwright.config.ts --grep-invert @manual",
    "test:e2e:list": "playwright test --config=playwright.config.ts --list",
    "test:e2e:manual": "playwright test --config=playwright.config.ts --grep @manual",
    "test:e2e:obs04": "playwright test --config=playwright.config.ts tests/e2e/obs04.timeline.e2e.spec.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@dagrejs/dagre": "^3.0.0",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.28.0",
    "@tanstack/react-query-devtools": "^5.28.0",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-codemirror": "^4.25.10",
    "@xyflow/react": "^12.10.2",
    "lucide-react": "^0.575.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.50.0",
    "react-intl": "^10.1.26",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "reactflow": "^11.11.4",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.22.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^24.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
