{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["@typescript-eslint", "react-hooks", "react-refresh"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react-hooks/recommended"
  ],
  "ignorePatterns": ["dist", "node_modules"],
  "rules": {
    "react-refresh/only-export-components": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          "@/modules/**",
          "!@/modules/registry",
          "!@/modules/types",
          "**/modules/**",
          "!**/modules/registry",
          "!**/modules/types"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/modules/registry.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/modules/exam/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@/modules/*/**",
              "!@/modules/exam/**",
              "!@/modules/registry",
              "!@/modules/types",
              "**/modules/*/**",
              "!**/modules/exam/**",
              "!**/modules/registry",
              "!**/modules/types",
              "**/org/**"
            ]
          }
        ]
      }
    },
    {
      "files": ["src/modules/org/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@/modules/*/**",
              "!@/modules/org/**",
              "!@/modules/registry",
              "!@/modules/types",
              "**/modules/*/**",
              "!**/modules/org/**",
              "!**/modules/registry",
              "!**/modules/types",
              "**/exam/**"
            ]
          }
        ]
      }
    }
  ]
}
