# letflow — deploy environment template
# Copy to deploy/.env (same directory as the compose files) and fill in
# real values. Never commit the real .env to git.

# Read by both the `app` and `db` services (docker-compose.test.yml uses
# the same env_file for both) — POSTGRES_PASSWORD sets the db's actual
# password, DATABASE_URL's embedded password must match it exactly.
POSTGRES_PASSWORD=

# Standard Ecto release DB URL: ecto://USER:PASSWORD@HOST/DATABASE
# HOST is the compose service name (`db`) — reachable over the compose
# network, not localhost/127.0.0.1. Password must match POSTGRES_PASSWORD
# above.
DATABASE_URL=ecto://letflow:REPLACE_WITH_POSTGRES_PASSWORD@db/letflow_test

# Optional — Ecto pool size, defaults to 30 if unset (config/runtime.exs).
POOL_SIZE=

# Optional -- Letflow.Admission's reserved-headroom subtracted from POOL_SIZE to
# derive the global admission concurrency cap (config/runtime.exs), defaults to 2
# if unset.
RESERVED_HEADROOM=

# Optional (REQ-439) -- comma-separated CIDRs/addresses of the reverse proxy whose
# X-Real-IP header Letflow trusts, e.g. the Docker bridge gateway nginx arrives
# from (NOT 127.0.0.1 when nginx proxies to the published port). Unset or blank =
# no proxy trusted. An invalid entry stops boot. In prod, boot is refused when
# LETFLOW_LOGIN_DISCOVERY_ENABLED is true and this is empty. Do not use a /0.
LETFLOW_TRUSTED_PROXIES=

# Optional (REQ-439) -- mount switch for the login-discovery endpoints: exactly
# true or false (any other value stops boot). Unset or blank = false in prod,
# true in dev/test.
LETFLOW_LOGIN_DISCOVERY_ENABLED=

# Optional (REQ-437) -- login-discovery disclosure mode: exactly uniform_plus_email
# (every request gets the same neutral answer) or redirect_single (a single active
# match is disclosed; the default). Unset or blank = redirect_single. Any other value
# stops boot (the value is not echoed). Not required.
LETFLOW_LOGIN_DISCOVERY_MODE=

# Optional (ISS-0993) -- the tenants.id UUID (hyphenated) of the platform tenant: the one
# tenant whose PLATFORM_ADMIN holds platform-scope operations (tenant registry, onboarding,
# platform migrations, event retention, global service catalogue). Not a secret. Unset or
# blank = no platform tenant (platform scope unavailable to everyone; fail closed). A value
# that is not a UUID stops boot (the value is not echoed). Set the same value on every
# backend instance.
LETFLOW_PLATFORM_TENANT_ID=

# REQUIRED (REQ-435, decision 0043 D-C) -- keyed-HMAC pepper for the login directory.
# Generate with: openssl rand -hex 32 (64 lowercase hex; not all-zero/all-f; must differ
# from LETFLOW_SECRETS_MASTER_KEY). Boot is refused in EVERY environment when this or
# LETFLOW_LOGIN_DIRECTORY_PEPPER_ID is missing or malformed. Never commit or log a value.
# See handoffs/WF02-REQ435-20261005/step-02e-infra-action.json before the merge deploys.
LETFLOW_LOGIN_DIRECTORY_PEPPER=

# REQUIRED (REQ-435) -- identifier of the pepper above: [a-z0-9_-], 1..32 chars, e.g.
# p2026a. Stored on every directory row; never reuse an id for a different pepper.
LETFLOW_LOGIN_DIRECTORY_PEPPER_ID=

# Optional (REQ-435) -- ONLY during a pepper rotation: the previous pepper and its id.
# Both or neither (one without the other stops boot); the previous values must differ
# from the current ones. Leave blank in steady state.
LETFLOW_LOGIN_DIRECTORY_PEPPER_PREVIOUS=
LETFLOW_LOGIN_DIRECTORY_PEPPER_PREVIOUS_ID=

# Optional (REQ-444) -- legal-confirmation marker for the email-first login directory. Leave
# BLANK until a named person has confirmed the lawful basis/controller (decision 0042 OQ-3).
# The value is that person's reference and a date, at least 8 characters; never logged. It is
# ADVISORY (it cannot prove a confirmation happened). Required, together with a delivering mail
# adapter (LETFLOW_MAIL_ADAPTER=smtp), to enable the feature outside dev/test: boot is refused
# otherwise. See docs/runbooks/login-directory-enablement.md.
LETFLOW_LOGIN_DIRECTORY_LEGAL_CONFIRMATION=
# Optional (REQ-441) -- notifier mail adapter. Unset/blank = no mail is sent (Noop).
# smtp = send via SMTP. Credentials are issued and owned by the platform operator and
# registered in the ai-dala-infra secrets inventory; no value belongs in this file.
LETFLOW_MAIL_ADAPTER=
# REQUIRED when LETFLOW_MAIL_ADAPTER=smtp (each stops boot when missing; values never echoed):
LETFLOW_SMTP_HOST=
LETFLOW_SMTP_PORT=
LETFLOW_SMTP_USERNAME=
LETFLOW_SMTP_PASSWORD=
LETFLOW_MAIL_FROM=
LETFLOW_PUBLIC_BASE_URL=
# Optional: starttls (default) | tls | none (none only for a loopback host and never in prod)
LETFLOW_SMTP_TLS=
# Optional: milliseconds, 2000..30000, default 15000 (hard timeout of one delivery attempt).
# Capacity note: up to max_concurrent (default 100) deliveries may hold a relay connection at
# once; set the relay's per-account connection limit >= that, or lower max_concurrent.
# The outbound rate ceiling is the global login-discovery limiter, not this setting.
LETFLOW_MAIL_TIMEOUT_MS=

# Tenant provisioner API (/admin/v1, QA only; docs/runbooks, decision 0072). All unset = the
# routes answer 404. Hashes are SHA-256 of the secret, 64 lowercase hex (openssl rand -hex 32).
# Never commit or log a secret. LETFLOW_PUBLIC_BASE_URL (above) is also used for the server URL.
# LETFLOW_PROVISIONER_CREDENTIAL_SHA256=
# LETFLOW_PROVISIONER_READONLY_CREDENTIAL_SHA256=
# Comma-separated domain suffixes a tenant hostname must end with (empty refuses every hostname)
# LETFLOW_PROVISIONER_ALLOWED_HOSTNAME_SUFFIXES=
# Demo lifetime in days (starting value 14)
# LETFLOW_PROVISIONER_DEMO_LIFETIME_DAYS=
