            "fields": [
              "document_id"
            ],
            "name": "idx_assets_commission_document_id"
          }
        ],
        "name": "assets_commission"
      },
      "display_name": "Asset commission (header)",
      "entity_definition_id": "304df40e-bc77-68c3-ab99-86f26d3f8563",
      "logical_shape_version": "361c3212087a7b86a8e59443800b34f4d690101c111bb20c7a81caaf5a60a3a1",
      "name": "assets_commission"
    },
    {
      "definition_json": {
        "description": "GH #3891 / REQ-751 (assets C10), docs/assets/asset-workflow-documents.md sections 1 and 2. One line of an asset commission: one asset card and a quantity. header_id is the record_id of the assets_commission header (not the document id); the foreign_keys entry fk_assets_commission_line_header_id promotes it to a uuid column with ON DELETE RESTRICT (inert on the soft-delete path). org_unit_id is the header's value copied by the module (queried; the scope column of decision 0076 R7, so a scoped read can filter lines). line_no is the position 1..n. asset_id is the record id of an assets_card. quantity is an exact decimal (precision 24, scale 9, decimal_strict); the value rule (whole number, 1 for fixed and intangible assets) is checked at issue. Written only by module assets; after issue nothing of a line changes.",
        "display_name": "Asset commission (line)",
        "fields": [
          {
            "name": "header_id",
            "queried": true,
            "required": true,
            "type": "string"
          },
          {
            "name": "org_unit_id",
            "queried": true,
            "required": true,
            "type": "string"
          },
          {
            "name": "line_no",
            "required": true,
            "type": "integer"
          },
          {
            "name": "asset_id",
            "required": true,
            "type": "string"
          },
          {
            "decimal_precision": 24,
            "decimal_scale": 9,
            "decimal_strict": true,
            "name": "quantity",
            "required": true,
            "type": "decimal"
          }
        ],
        "foreign_keys": [
          {
            "field": "header_id",
            "name": "fk_assets_commission_line_header_id",
            "references_entity": "assets_commission"
          }
        ],
        "indexes": [
          {
            "fields": [
              "header_id"
            ],
            "name": "idx_assets_commission_line_header_id"
          }
        ],
        "name": "assets_commission_line"
      },
      "display_name": "Asset commission (line)",
      "entity_definition_id": "e63ce895-75e1-0901-9226-d001c5bf7825",
      "logical_shape_version": "83d8cecc34d7e00cbf097c6bf533d48c1433dffc6af4ce935b9815637a93821e",
      "name": "assets_commission_line"
    },
    {
      "definition_json": {
        "constraints": [
          {
            "fields": [
              "document_id",
              "mark"
            ],
            "name": "uq_assets_posting_mark_doc_mark",
            "type": "unique"
          }
        ],
        "description": "GH #3890 / REQ-752 (assets C10), decision 0073 (Consequences, cost note), docs/assets/asset-workflow-documents.md section 8. The bookkeeping record that says an asset document was posted (mark posted) or reversed (mark reversed). It is written only by the write handlers post_document and reverse_document of module assets, in the same transaction as the ledger entry (HandlerWrites.create/3 and post/3). document_id is the id of the versioned document, document_type its type key, version_no the issued version, org_unit_id the issuing org unit (queried; the scope column of decision 0076 R7), reason_code the reversal reason (set on a reversed mark only). The unique constraint uq_assets_posting_mark_doc_mark allows one posted and one reversed mark per document: a second completion of a posting for the same document violates it, so the whole completion transaction rolls back before any ledger write.",
        "display_name": "Asset posting mark",
        "fields": [
          {
            "name": "document_id",
            "queried": true,
            "required": true,
            "type": "string"
          },
          {
            "name": "document_type",
            "required": true,
            "type": "string"
          },
          {
            "name": "version_no",
            "required": true,
            "type": "integer"
          },
          {
            "enum_values": [
              "posted",
              "reversed"
            ],
            "name": "mark",
            "queried": true,
            "required": true,
            "type": "enum"
          },
          {
            "name": "org_unit_id",
            "queried": true,
            "required": true,
            "type": "string"
          },
          {
            "name": "reason_code",
            "type": "string"
          }
        ],
        "name": "assets_posting_mark"
      },
