{
  "name": "count_order",
  "display_name": "Count order",
  "description": "REQ-700 / GH #3737. The header of a count order (inventory taking): one org unit, a kind (full or selective), the planned period, the chair, a status and the issued document. status is draft, ordered, counting, counted, signed, posted or cancelled. org_unit_id is the scope column (decision 0076 R7). Master references (org unit, employee) are record ids checked in code (0076 R6), not foreign keys. cut_off_at and cutoff_seq are filled by REQ-701.",
  "fields": [
    {"name": "org_unit_id", "type": "string", "required": true, "queried": true},
    {"name": "kind", "type": "enum", "required": true, "queried": true, "enum_values": ["full", "selective"]},
    {"name": "planned_start", "type": "datetime", "required": true, "queried": true},
    {"name": "planned_end", "type": "datetime", "required": true, "queried": true},
    {"name": "chair_employee_id", "type": "string", "required": true, "queried": true},
    {"name": "note", "type": "string"},
    {"name": "status", "type": "enum", "required": true, "queried": true, "enum_values": ["draft", "ordered", "counting", "counted", "signed", "posted", "cancelled"]},
    {"name": "document_id", "type": "string"},
    {"name": "number", "type": "string", "queried": true},
    {"name": "issued_at", "type": "datetime"},
    {"name": "issued_by", "type": "string"},
    {"name": "cancelled_at", "type": "datetime"},
    {"name": "cancelled_by", "type": "string"},
    {"name": "cut_off_at", "type": "datetime"},
    {"name": "cutoff_seq", "type": "integer"}
  ],
  "indexes": [
    {"name": "idx_count_order_org_unit_status", "fields": ["org_unit_id", "status"]}
  ]
}
